<?xml version="1.0"?>
<ruleset name="FrauxSearch">
	<description>FrauxSearch PHP checks.</description>
	<arg name="extensions" value="php" />
	<arg name="parallel" value="4" />
	<file>src</file>
	<file>maintenance</file>
	<rule ref="Generic.CodeAnalysis.EmptyPHPStatement" />
	<rule ref="Generic.CodeAnalysis.JumbledIncrementer" />
	<rule ref="Generic.CodeAnalysis.UnconditionalIfStatement" />
	<rule ref="Generic.Files.ByteOrderMark" />
	<rule ref="Generic.Files.LineEndings" />
	<rule ref="Generic.PHP.CharacterBeforePHPOpeningTag" />
	<rule ref="Generic.PHP.DisallowShortOpenTag" />
	<rule ref="Generic.PHP.BacktickOperator" />
	<rule ref="Generic.VersionControl.GitMergeConflict" />
	<rule ref="MediaWiki.Classes.UnusedUseStatement" />
	<rule ref="MediaWiki.Usage.DeprecatedConstantUsage" />
	<rule ref="MediaWiki.Usage.DeprecatedGlobalVariables" />
	<rule ref="MediaWiki.Usage.ForbiddenFunctions" />
	<rule ref="MediaWiki.Usage.PlusStringConcat" />
	<rule ref="MediaWiki.Usage.ReferenceThis" />
	<rule ref="Squiz.Functions.FunctionDuplicateArgument" />
	<rule ref="Squiz.PHP.NonExecutableCode" />
	<rule ref="Squiz.Scope.StaticThisUsage" />
	<rule ref="PSR2.Classes.PropertyDeclaration" />
	<rule ref="PSR12.Properties.ConstantVisibility" />
	<rule ref="Zend.Files.ClosingTag" />
</ruleset>
